{
  "name": "@dsh-external/dsh-client-ui-theme-go",
  "description": "DSH Go visual language as a hot-pluggable client theme for DeepSeek Harness — six accents, light/dark/system, zero DOM rewrite.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "theme",
    "client-plugin",
    "light-dark"
  ],
  "engines": {
    "dsh": ">=0.2.1-alpha.1 <0.3.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "check:palettes": "node tools/check-palettes.mjs",
    "check:tokens": "node tools/check-tokens.mjs",
    "check:pack": "node tools/check-pack.mjs",
    "test": "vitest run",
    "verify": "pnpm build && pnpm typecheck && pnpm test && pnpm check:palettes && pnpm check:tokens && pnpm check:pack",
    "e2e:lifecycle": "node tools/e2e-lifecycle.mjs",
    "e2e:degraded": "node tools/e2e-degraded.mjs",
    "e2e:dual": "node tools/e2e-dual-version.mjs",
    "e2e:uninstall": "node tools/e2e-uninstall.mjs",
    "e2e:scenarios": "node tools/e2e-scenarios.mjs",
    "preview:accents": "node tools/preview-accents.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
